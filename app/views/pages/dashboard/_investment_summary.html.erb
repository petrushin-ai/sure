<%# locals: (investment_statement:, period:, **args) %>

<% if investment_statement.investment_accounts.any? %>
  <div id="investment-summary" class="space-y-4">
    <div class="flex justify-between gap-4 px-4">
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <h2 class="text-lg font-medium"><%= t(".title") %></h2>
        </div>

        <p class="text-primary text-3xl font-medium privacy-sensitive">
          <%= format_money(investment_statement.portfolio_value_money) %>
        </p>

        <% trend = investment_statement.unrealized_gains_trend %>
        <% if trend %>
          <div class="flex items-center gap-2 text-sm">
            <span class="text-secondary"><%= t(".total_return") %>:</span>
            <span class="font-medium privacy-sensitive" style="color: <%= trend.color %>">
              <%= format_money(Money.new(trend.value, Current.family.currency)) %>
              (<%= trend.percent_formatted %>)
            </span>
          </div>
        <% end %>
      </div>
    </div>

    <% holdings = investment_statement.dashboard_positions(limit: 5) %>
    <% if holdings.any? %>
      <%# Four financial columns must keep one stable grid. On narrow screens
          the table scrolls horizontally rather than squeezing labels/values
          into mismatched columns. This mirrors the Balance Sheet widget. %>
      <div class="bg-container-inset rounded-xl p-1 mx-4 overflow-x-auto overscroll-x-contain" data-investment-scroll-container>
        <div class="min-w-[42rem]">
          <div class="px-4 py-2 flex items-center gap-4 uppercase text-xs font-medium text-secondary">
            <div class="min-w-64 flex-1"><%= t(".holding") %></div>
            <div class="ml-auto flex items-center gap-2 text-right">
              <div class="w-20 shrink-0"><%= t(".weight") %></div>
              <div class="w-24 shrink-0" data-investment-column="value"><%= t(".value") %></div>
              <div class="w-20 shrink-0"><%= t(".return") %></div>
            </div>
          </div>

          <div class="rounded-lg shadow-border-xs bg-container font-medium text-sm overflow-hidden">
            <% holdings.each_with_index do |holding, idx| %>
              <% row_classes = "p-4 flex items-center gap-4 #{idx < holdings.size - 1 ? "table-divider" : ""}" %>

              <% if holding.breakdowns.any? %>
                <details class="group" data-portfolio-ticker="<%= holding.ticker %>" <%= "open" if holding.breakdowns.one? %>>
                  <summary class="list-none [&::-webkit-details-marker]:hidden cursor-pointer <%= row_classes %>">
                    <%= render "pages/dashboard/investment_position_row", holding: holding %>
                  </summary>

                  <div class="text-xs text-secondary">
                    <% holding.breakdowns.each_with_index do |breakdown, breakdown_idx| %>
                      <div class="pl-16 pr-4 py-3 flex items-center gap-4 <%= "table-divider" if breakdown_idx < holding.breakdowns.size - 1 %>">
                        <div class="min-w-64 flex-1 truncate">
                          <%= link_to breakdown.account.name, account_path(breakdown.account), class: "hover:text-primary" %>
                        </div>
                        <div class="ml-auto flex items-center gap-2 text-right">
                          <div class="w-20 shrink-0" aria-hidden="true"></div>
                          <div class="w-24 shrink-0 privacy-sensitive whitespace-nowrap" data-investment-breakdown-value>
                            <%= format_money(breakdown.amount_money) %>
                          </div>
                          <div class="w-20 shrink-0" aria-hidden="true"></div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </details>
              <% else %>
                <div class="<%= row_classes %>" data-investment-account-id="<%= holding.account.id if holding.account_position? %>">
                  <%= render "pages/dashboard/investment_position_row", holding: holding %>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%# Investment Activity Summary %>
    <% totals = investment_statement.totals(period: period) %>
    <% if totals.trades_count > 0 || totals.contributions.to_f > 0 || totals.withdrawals.to_f > 0 %>
      <div class="bg-container-inset rounded-xl p-1 mx-4">
        <div class="px-4 py-2 flex items-center uppercase text-xs font-medium text-secondary">
          <%= t(".period_activity", period: period.label) %>
        </div>
        <div class="shadow-border-xs rounded-lg bg-container font-medium text-sm">
            <div class="p-4 grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 p-1.5 rounded-full bg-green-500/10 flex items-center justify-center">
                <%= icon "trending-up", size: "sm", color: "green" %>
              </div>
              <div>
                <p class="text-xs text-secondary"><%= t(".contributions") %></p>
                <p class="font-medium text-primary privacy-sensitive"><%= format_money(totals.contributions) %></p>
              </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 p-1.5 rounded-full bg-orange-500/10 flex items-center justify-center">
                <%= icon "trending-down", size: "sm", color: "orange" %>
              </div>
              <div>
                <p class="text-xs text-secondary"><%= t(".withdrawals") %></p>
                <p class="font-medium text-primary privacy-sensitive"><%= format_money(totals.withdrawals) %></p>
              </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 p-1.5 rounded-full bg-blue-500/10 flex items-center justify-center">
                <%= icon "arrow-left-right", size: "sm", color: "blue" %>
              </div>
              <div>
                <p class="text-xs text-secondary"><%= t(".trades") %></p>
                <p class="font-medium text-primary"><%= totals.trades_count %></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<% content_for :title, t(".title") %>
<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t(".title")) %>
  <% dialog.with_body do %>
    <%= styled_form_with url: complete_account_setup_okx_item_path(@okx_item), method: :post, local: true, class: "space-y-6", data: { turbo_frame: "_top" } do |form| %>
      <div class="bg-surface border border-primary p-4 rounded-lg text-sm text-primary"><%= t(".instructions") %></div>
      <%= form.date_field :sync_start_date,
                          label: t("settings.providers.okx_panel.sync_start_date_label"),
                          value: @okx_item.sync_start_date || (Date.current - 90.days),
                          max: Date.current %>
      <% @okx_accounts.each do |okx_account| %>
        <div class="space-y-3 p-3 border border-primary rounded-lg">
          <label class="flex items-center gap-3 cursor-pointer">
            <%= check_box_tag "selected_accounts[]", okx_account.id, true, class: "checkbox checkbox--dark" %>
            <span class="flex-1 text-primary"><%= okx_account.name %></span>
            <span class="text-secondary"><%= number_with_delimiter(okx_account.current_balance || 0) %> <%= okx_account.currency %></span>
          </label>
          <div class="form-field">
            <div class="form-field__body">
              <%= label_tag "account_names_#{okx_account.id}", t(".account_name_label"), class: "form-field__label" %>
              <%= text_field_tag "account_names[#{okx_account.id}]", okx_account.name, id: "account_names_#{okx_account.id}", class: "form-field__input", autocomplete: "off" %>
            </div>
          </div>
        </div>
      <% end %>
      <div class="flex gap-3">
        <%= render DS::Button.new(text: t(".import_selected"), variant: "primary", icon: "plus", type: "submit") %>
        <%= render DS::Link.new(text: t(".cancel"), variant: "secondary", href: accounts_path) %>
      </div>
    <% end %>
  <% end %>
<% end %>

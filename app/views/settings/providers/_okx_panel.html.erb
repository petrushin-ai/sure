<div id="okx-providers-panel" class="space-y-4">
  <% items = local_assigns[:okx_items] || @okx_items || Current.family.okx_items.active.ordered %>

  <%= render DS::Alert.new(
        variant: :warning,
        title: t("settings.providers.okx_panel.read_only_title"),
        message: t("settings.providers.okx_panel.read_only_body")
      ) %>

  <%= render "settings/providers/setup_steps", steps: [
        t("settings.providers.okx_panel.step1_html").html_safe,
        t("settings.providers.okx_panel.step2"),
        t("settings.providers.okx_panel.step3")
      ] %>

  <div class="bg-surface-inset rounded-xl p-4 text-sm">
    <p class="text-xs font-medium uppercase text-subdued tracking-wider mb-2"><%= t("settings.providers.okx_panel.ip_hint_title") %></p>
    <p class="text-secondary"><%= t("settings.providers.okx_panel.ip_hint_body") %></p>
    <% if ENV["OKX_EGRESS_IP"].present? %>
      <code class="mt-2 block text-xs bg-container px-2 py-1 rounded font-mono text-primary"><%= ENV["OKX_EGRESS_IP"] %></code>
    <% else %>
      <p class="mt-1 text-xs text-secondary italic"><%= t("settings.providers.okx_panel.ip_hint_contact_admin") %></p>
    <% end %>
  </div>

  <% error_msg = local_assigns[:error_message] || @error_message %>
  <%= render DS::Alert.new(message: error_msg, variant: :error) if error_msg.present? %>

  <% items.each do |item| %>
    <%= render DS::Disclosure.new(variant: :card) do |disclosure| %>
      <% disclosure.with_summary_content do %>
        <div class="flex items-center gap-3 min-w-0">
          <div class="w-10 h-10 rounded-full bg-container flex items-center justify-center"><%= icon "coins", size: "md", class: "text-primary" %></div>
          <div class="min-w-0">
            <p class="font-medium text-primary truncate"><%= item.name %></p>
            <p class="text-xs text-secondary"><%= item.syncing? ? t("settings.providers.okx_panel.syncing") : item.sync_status_summary %></p>
          </div>
        </div>
      <% end %>

      <div class="mt-4 space-y-4">
        <div class="flex flex-wrap gap-2">
          <%= render DS::Button.new(
            text: t("settings.providers.okx_panel.sync"),
            icon: "refresh-cw",
            variant: :outline,
            size: :sm,
            href: sync_okx_item_path(item),
            method: :post,
            disabled: item.syncing?
          ) %>
          <% if item.unlinked_accounts_count > 0 %>
            <%= render DS::Link.new(text: t("settings.providers.okx_panel.setup_accounts"), icon: "settings", variant: "secondary", href: setup_accounts_okx_item_path(item), frame: :modal) %>
          <% end %>
          <%= render DS::Button.new(
            text: t("settings.providers.okx_panel.disconnect"),
            icon: "trash-2",
            variant: :outline_destructive,
            size: :sm,
            href: okx_item_path(item),
            method: :delete,
            data: { turbo_confirm: t("settings.providers.okx_panel.disconnect_confirm", name: item.name) }
          ) %>
        </div>

        <%= styled_form_with model: item, url: okx_item_path(item), scope: :okx_item, method: :patch, data: { turbo: true }, class: "space-y-3" do |form| %>
          <%= form.text_field :name, label: t("settings.providers.okx_panel.connection_name_label") %>
          <%= form.text_field :api_key, label: t("settings.providers.okx_panel.api_key_label"), placeholder: t("settings.providers.okx_panel.keep_secret_placeholder"), type: :password, value: nil %>
          <%= form.text_field :api_secret, label: t("settings.providers.okx_panel.api_secret_label"), placeholder: t("settings.providers.okx_panel.keep_secret_placeholder"), type: :password, value: nil %>
          <%= form.text_field :passphrase, label: t("settings.providers.okx_panel.passphrase_label"), placeholder: t("settings.providers.okx_panel.keep_secret_placeholder"), type: :password, value: nil %>
          <% if item.credentials_configured? %>
            <p class="text-xs text-success"><%= icon "shield-check", size: "sm", class: "inline-block mr-1" %><%= t("settings.providers.okx_panel.credentials_saved") %></p>
          <% end %>
          <div class="flex justify-end"><%= form.submit t("settings.providers.okx_panel.update_connection") %></div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% okx_item = Current.family.okx_items.build(name: t("settings.providers.okx_panel.default_connection_name")) %>
  <h3 class="flex items-center gap-2 text-sm font-medium text-primary"><%= icon "plus", size: "sm" %><%= t("settings.providers.okx_panel.add_connection") %></h3>
  <%= styled_form_with model: okx_item, url: okx_items_path, scope: :okx_item, method: :post, data: { turbo: true }, class: "space-y-3" do |form| %>
    <%= form.text_field :name, label: t("settings.providers.okx_panel.connection_name_label"), placeholder: t("settings.providers.okx_panel.connection_name_placeholder") %>
    <%= form.text_field :api_key, label: t("settings.providers.okx_panel.api_key_label"), type: :password, value: nil %>
    <%= form.text_field :api_secret, label: t("settings.providers.okx_panel.api_secret_label"), type: :password, value: nil %>
    <%= form.text_field :passphrase, label: t("settings.providers.okx_panel.passphrase_label"), type: :password, value: nil %>
    <div class="flex justify-end"><%= form.submit t("settings.providers.okx_panel.add_connection") %></div>
  <% end %>
</div>

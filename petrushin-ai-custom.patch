+    def api_key_unique_within_family
+      return if family_id.blank? || api_key.blank?
+
+      duplicate = self.class.active
+        .where(family_id: family_id, api_key: api_key)
+        .where.not(id: id)
+        .exists?
+
+      errors.add(:api_key, :taken) if duplicate
+    end
 end

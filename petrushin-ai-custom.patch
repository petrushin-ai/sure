diff --git a/bin/regenerate-downstream-patch b/bin/regenerate-downstream-patch
new file mode 100755
index 00000000..c08f95fd
--- /dev/null
+++ b/bin/regenerate-downstream-patch
@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+
+set -Eeuo pipefail
+
+readonly repo_root="$(git rev-parse --show-toplevel)"
+readonly upstream_marker="$repo_root/.upstream-commit"
+readonly patch_file="$repo_root/petrushin-ai-custom.patch"
+
+if [[ ! -s "$upstream_marker" ]]; then
+  printf 'Missing or empty upstream marker: %s\n' "$upstream_marker" >&2
+  exit 1
+fi
+
+upstream_commit="$(tr -d '[:space:]' < "$upstream_marker")"
+if [[ ! "$upstream_commit" =~ ^[0-9a-f]{40}$ ]]; then
+  printf 'Expected a full 40-character SHA in %s.\n' "$upstream_marker" >&2
+  exit 1
+fi
+
+if ! git cat-file -e "${upstream_commit}^{commit}" 2>/dev/null; then
+  printf 'Upstream commit %s is not available locally. Fetch upstream first.\n' "$upstream_commit" >&2
+  exit 1
+fi
+
+patch_tmp_file="$(mktemp "${TMPDIR:-/tmp}/sure-downstream-patch.XXXXXX")"
+trap 'rm -f "$patch_tmp_file"' EXIT
+
+git diff --binary "$upstream_commit" HEAD -- \
+  . \
+  ':(exclude)petrushin-ai-custom.patch' > "$patch_tmp_file"
+
+if [[ ! -s "$patch_tmp_file" ]]; then
+  printf 'Refusing to write an empty downstream patch.\n' >&2
+  exit 1
+fi
+
+mv "$patch_tmp_file" "$patch_file"
+printf 'Regenerated %s from upstream %s to HEAD %s.\n' \
+  "$patch_file" "$upstream_commit" "$(git rev-parse HEAD)"
diff --git a/bin/upgrade-upstream b/bin/upgrade-upstream
new file mode 100755
index 00000000..552167e3
--- /dev/null
+++ b/bin/upgrade-upstream
@@ -0,0 +1,95 @@
+#!/usr/bin/env bash
+
+set -Eeuo pipefail
+
+target_ref="${1:-}"
+if [[ -z "$target_ref" ]]; then
+  printf 'Usage: bin/upgrade-upstream <upstream-ref>\n' >&2
+  printf 'Example: bin/upgrade-upstream upstream/main\n' >&2
+  exit 1
+fi
+
+readonly repo_root="$(git rev-parse --show-toplevel)"
+readonly patch_file="$repo_root/petrushin-ai-custom.patch"
+readonly upstream_marker="$repo_root/.upstream-commit"
+
+if [[ ! -s "$patch_file" || ! -s "$upstream_marker" ]]; then
+  printf 'The downstream patch and upstream marker must both exist before an upgrade.\n' >&2
+  exit 1
+fi
+
+if [[ -n "$(git status --porcelain)" ]]; then
+  printf 'Working tree is not clean. Commit or stash changes first.\n' >&2
+  exit 1
+fi
+
+if ! git remote get-url upstream >/dev/null 2>&1; then
+  printf 'Missing upstream remote. Add https://github.com/we-promise/sure.git as upstream.\n' >&2
+  exit 1
+fi
+
+git fetch origin --prune
+git fetch upstream --prune --tags
+git switch main
+git merge --ff-only origin/main
+bin/verify-downstream-patch
+
+current_upstream="$(tr -d '[:space:]' < "$upstream_marker")"
+if target_commit="$(git rev-parse --verify "${target_ref}^{commit}" 2>/dev/null)"; then
+  :
+elif target_commit="$(git rev-parse --verify "upstream/${target_ref}^{commit}" 2>/dev/null)"; then
+  :
+else
+  printf 'Could not resolve upstream target %s.\n' "$target_ref" >&2
+  exit 1
+fi
+
+if [[ "$target_commit" == "$current_upstream" ]]; then
+  printf 'Already based on upstream %s.\n' "$current_upstream"
+  exit 0
+fi
+
+if ! git merge-base --is-ancestor "$current_upstream" "$target_commit"; then
+  printf 'Target %s is not a descendant of recorded upstream %s.\n' \
+    "$target_commit" "$current_upstream" >&2
+  exit 1
+fi
+
+target_short="$(git rev-parse --short=12 "$target_commit")"
+branch_name="chore/upstream-${target_short}"
+safety_tag="pre-upstream-${target_short}-upgrade"
+
+if git show-ref --verify --quiet "refs/heads/${branch_name}"; then
+  printf 'Branch %s already exists. Remove or rename it before retrying.\n' "$branch_name" >&2
+  exit 1
+fi
+
+if ! git show-ref --verify --quiet "refs/tags/${safety_tag}"; then
+  git tag "$safety_tag" main
+fi
+
+patch_backup="$(mktemp "${TMPDIR:-/tmp}/sure-custom-patch.XXXXXX")"
+trap 'rm -f "$patch_backup"' EXIT
+cp "$patch_file" "$patch_backup"
+
+git switch -c "$branch_name" "$target_commit"
+if ! git apply --index --3way "$patch_backup"; then
+  printf '\nDownstream patch conflicts with %s. Resolve the index, preserve every active item in docs/UPSTREAM.md, then continue manually.\n' \
+    "$target_commit" >&2
+  exit 1
+fi
+
+printf '%s\n' "$target_commit" > "$upstream_marker"
+git add -A
+git commit -m "Reapply downstream patches on upstream ${target_short}"
+
+bin/regenerate-downstream-patch
+git add "$patch_file"
+git commit --amend --no-edit
+bin/verify-downstream-patch
+
+printf '\nUpgrade branch is ready. Next steps:\n'
+printf '  1. Run the focused and full test suites from docs/UPSTREAM.md.\n'
+printf '  2. git switch main && git merge --no-ff --no-edit %s\n' "$branch_name"
+printf '  3. bin/verify-downstream-patch && git push origin main\n'
+printf '  4. Publish and deploy only after direct-main CI is green.\n'
diff --git a/bin/verify-downstream-patch b/bin/verify-downstream-patch
new file mode 100755
index 00000000..97d04be6
--- /dev/null
+++ b/bin/verify-downstream-patch
@@ -0,0 +1,77 @@
+#!/usr/bin/env bash
+
+set -Eeuo pipefail
+
+readonly repo_root="$(git rev-parse --show-toplevel)"
+readonly upstream_marker="$repo_root/.upstream-commit"
+readonly patch_file="$repo_root/petrushin-ai-custom.patch"
+
+if [[ ! -s "$upstream_marker" ]]; then
+  printf 'Missing or empty upstream marker: %s\n' "$upstream_marker" >&2
+  exit 1
+fi
+
+if [[ ! -s "$patch_file" ]]; then
+  printf 'Missing or empty downstream patch: %s\n' "$patch_file" >&2
+  exit 1
+fi
+
+upstream_commit="$(tr -d '[:space:]' < "$upstream_marker")"
+if [[ ! "$upstream_commit" =~ ^[0-9a-f]{40}$ ]]; then
+  printf 'Expected a full 40-character SHA in %s.\n' "$upstream_marker" >&2
+  exit 1
+fi
+
+if ! git cat-file -e "${upstream_commit}^{commit}" 2>/dev/null; then
+  printf 'Upstream commit %s is not available locally. Fetch upstream first.\n' "$upstream_commit" >&2
+  exit 1
+fi
+
+if ! git merge-base --is-ancestor "$upstream_commit" HEAD; then
+  printf 'Recorded upstream commit %s is not an ancestor of HEAD.\n' "$upstream_commit" >&2
+  exit 1
+fi
+
+verify_tmp_root="$(mktemp -d "${TMPDIR:-/tmp}/sure-patch-verify.XXXXXX")"
+verify_worktree="$verify_tmp_root/worktree"
+expected_patch="$verify_tmp_root/expected.patch"
+apply_log="$verify_tmp_root/apply.log"
+worktree_added=false
+
+cleanup() {
+  if [[ "$worktree_added" == true ]]; then
+    git worktree remove --force "$verify_worktree" >/dev/null 2>&1 || true
+  fi
+  rm -rf "$verify_tmp_root"
+}
+trap cleanup EXIT
+
+git diff --binary "$upstream_commit" HEAD -- \
+  . \
+  ':(exclude)petrushin-ai-custom.patch' > "$expected_patch"
+
+if ! cmp -s "$expected_patch" "$patch_file"; then
+  printf 'Downstream patch is stale. Run bin/regenerate-downstream-patch and amend the commit.\n' >&2
+  exit 1
+fi
+
+git worktree add --detach "$verify_worktree" "$upstream_commit" >/dev/null
+worktree_added=true
+if ! git -C "$verify_worktree" apply --check --3way "$patch_file" >"$apply_log" 2>&1; then
+  printf 'Downstream patch does not apply cleanly to upstream %s:\n' "$upstream_commit" >&2
+  sed -n '1,120p' "$apply_log" >&2
+  exit 1
+fi
+
+if ! git -C "$verify_worktree" apply --index --3way "$patch_file" >"$apply_log" 2>&1; then
+  printf 'Downstream patch failed while applying to upstream %s:\n' "$upstream_commit" >&2
+  sed -n '1,120p' "$apply_log" >&2
+  exit 1
+fi
+
+if git -C "$verify_worktree" diff --cached --quiet; then
+  printf 'Downstream patch applied no changes to upstream %s.\n' "$upstream_commit" >&2
+  exit 1
+fi
+
+printf 'Downstream patch is current and applies cleanly to upstream %s.\n' "$upstream_commit"
